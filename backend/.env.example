# ==============================================================================
# LinkUp Backend API - Environment Configuration Template
# ==============================================================================
# Instructions:
# Copy this file to .env and replace placeholder values with your real configuration.
# NEVER commit the actual .env file or production secrets to Git source control.
# ==============================================================================

# Core Application Settings
PROJECT_NAME="LinkUp API"
ENVIRONMENT="development"       # Options: development, testing, production
DEBUG=True
API_V1_STR="/api/v1"

# CORS Configuration
# Comma-separated list of allowed origins. In production, specify your Flutter web / app domains.
CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000"

# PostgreSQL Database Configuration
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
# Supabase Pooler Example: postgresql+psycopg://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/linkup"
TEST_DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/linkup_test"

# Firebase Authentication & Admin SDK
# Option A: Path to service account JSON file on disk (gitignored)
FIREBASE_CREDENTIALS_PATH="secrets/firebase-service-account.json"

# Option B: Raw JSON string of service account (ideal for cloud deployment on Render)
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Firebase Project ID
FIREBASE_PROJECT_ID="link-up-e0998"

# n8n Opportunity Ingestion Security Secret
# The n8n workflow must send this exact value in the HTTP header: X-Ingest-Key: <secret>
N8N_INGEST_SECRET="dev-insecure-ingest-secret"

# Pagination Defaults
DEFAULT_PAGE_LIMIT=20
MAX_PAGE_LIMIT=100
